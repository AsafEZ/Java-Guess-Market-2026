<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="usersSplitPane" dividerPositions="0.28" orientation="HORIZONTAL"
           styleClass="workspace-split-pane"
           xmlns="http://javafx.com/javafx/25.0.4"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="guessmarket.javafx.controller.UsersController">
    <items>
        <VBox fx:id="userBrowserPane" minWidth="220.0" prefWidth="280.0"
              spacing="12.0" styleClass="master-pane">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
            </padding>
            <Label styleClass="section-title" text="Users"/>
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn minWidth="120.0" prefWidth="160.0" text="User"/>
                    <TableColumn minWidth="90.0" prefWidth="110.0" text="Balance"/>
                    <TableColumn minWidth="84.0" prefWidth="96.0" text="Status"/>
                </columns>
                <placeholder>
                    <Label text="No users loaded"/>
                </placeholder>
            </TableView>
        </VBox>
        <StackPane fx:id="userDetailStateStack" minWidth="0.0" styleClass="detail-state-stack">
            <children>
                <VBox fx:id="userEmptyState" alignment="CENTER" spacing="8.0"
                      styleClass="empty-state">
                    <Label styleClass="empty-state-title" text="No user selected"/>
                    <Label styleClass="muted-text" text="Select a user to view account activity"/>
                </VBox>
                <ScrollPane fx:id="userDetailsScrollPane" fitToWidth="true" hbarPolicy="AS_NEEDED"
                            pannable="true" vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox fx:id="userDetailsPane" spacing="16.0" styleClass="detail-pane">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                            </padding>
                            <GridPane fx:id="userHeaderGrid" hgap="12.0" vgap="8.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints minWidth="120.0"/>
                                    <ColumnConstraints minWidth="120.0"/>
                                </columnConstraints>
                                <children>
                                    <Label fx:id="selectedUserNameLabel" styleClass="detail-title"
                                           text="User details" GridPane.columnIndex="0"
                                           GridPane.rowIndex="0"/>
                                    <Label styleClass="metadata-label" text="Account balance"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label fx:id="selectedUserBalanceLabel" styleClass="account-balance"
                                           text="-" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    <Label styleClass="metadata-label" text="Status"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label fx:id="selectedUserStatusLabel" styleClass="status-badge"
                                           text="-" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                </children>
                            </GridPane>
                            <VBox spacing="10.0" styleClass="content-section">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label styleClass="subsection-title"
                                           text="Participation and Market Maker events"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label styleClass="filter-label" text="Show"/>
                                    <ComboBox fx:id="participationScopeChoice" prefWidth="110.0">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Active"/>
                                                <String fx:value="All"/>
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </HBox>
                                <TableView fx:id="userEventsTable" minHeight="180.0">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn minWidth="150.0" text="Event"/>
                                        <TableColumn minWidth="94.0" text="Status"/>
                                        <TableColumn minWidth="116.0" text="Role"/>
                                        <TableColumn minWidth="100.0" text="Method"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No event activity"/>
                                    </placeholder>
                                </TableView>
                            </VBox>
                            <VBox spacing="10.0" styleClass="content-section">
                                <Label styleClass="subsection-title"
                                       text="Selected event details and trade"/>
                                <TabPane fx:id="userPositionTabs" minHeight="240.0"
                                         tabClosingPolicy="UNAVAILABLE">
                                    <tabs>
                                        <Tab text="Positions">
                                            <content>
                                                <TableView fx:id="userOptionPositionsTable">
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                                    </columnResizePolicy>
                                                    <columns>
                                                        <TableColumn minWidth="120.0" text="Option"/>
                                                        <TableColumn minWidth="88.0" text="Shares"/>
                                                        <TableColumn minWidth="112.0" text="Amount paid"/>
                                                        <TableColumn minWidth="112.0" text="Commission"/>
                                                        <TableColumn minWidth="84.0" text="Winner"/>
                                                    </columns>
                                                    <placeholder>
                                                        <Label text="No position for this event"/>
                                                    </placeholder>
                                                </TableView>
                                            </content>
                                        </Tab>
                                        <Tab text="Trade history">
                                            <content>
                                                <TableView fx:id="userTradeHistoryTable">
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                                    </columnResizePolicy>
                                                    <columns>
                                                        <TableColumn minWidth="64.0" text="#"/>
                                                        <TableColumn minWidth="120.0" text="Option"/>
                                                        <TableColumn minWidth="90.0" text="Quantity"/>
                                                        <TableColumn minWidth="106.0" text="Share cost"/>
                                                        <TableColumn minWidth="106.0" text="Commission"/>
                                                        <TableColumn minWidth="96.0" text="Total"/>
                                                    </columns>
                                                    <placeholder>
                                                        <Label text="No trades recorded"/>
                                                    </placeholder>
                                                </TableView>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </VBox>
                            <VBox fx:id="userActionShell" spacing="10.0" styleClass="content-section">
                                <Label styleClass="subsection-title" text="User and market actions"/>
                                <VBox fx:id="lmsrActionPane" spacing="8.0" styleClass="action-group">
                                    <Label styleClass="action-title" text="LMSR purchase"/>
                                    <HBox spacing="8.0">
                                        <ComboBox disable="true" maxWidth="1.7976931348623157E308"
                                                  promptText="Option" HBox.hgrow="ALWAYS"/>
                                        <TextField disable="true" promptText="Quantity"/>
                                        <Button disable="true" mnemonicParsing="false"
                                                text="Purchase shares"/>
                                    </HBox>
                                </VBox>
                                <VBox fx:id="orderBookActionPane" spacing="8.0" styleClass="action-group">
                                    <fx:define>
                                        <ToggleGroup fx:id="orderSideGroup"/>
                                    </fx:define>
                                    <Label styleClass="action-title" text="Order Book order"/>
                                    <HBox spacing="8.0">
                                        <ToggleButton disable="true" mnemonicParsing="false"
                                                      text="Buy" toggleGroup="$orderSideGroup"/>
                                        <ToggleButton disable="true" mnemonicParsing="false"
                                                      text="Sell" toggleGroup="$orderSideGroup"/>
                                        <ComboBox disable="true" promptText="Option"/>
                                        <TextField disable="true" promptText="Quantity"/>
                                        <TextField disable="true" promptText="Price per share"/>
                                        <Button disable="true" mnemonicParsing="false" text="Submit order"/>
                                    </HBox>
                                </VBox>
                                <VBox fx:id="marketMakerActionPane" spacing="8.0" styleClass="action-group">
                                    <Label styleClass="action-title" text="Market Maker actions"/>
                                    <HBox spacing="8.0">
                                        <Button disable="true" mnemonicParsing="false" text="Open event"/>
                                        <ComboBox disable="true" maxWidth="1.7976931348623157E308"
                                                  promptText="Winning option" HBox.hgrow="ALWAYS"/>
                                        <Button disable="true" mnemonicParsing="false" text="Close event"/>
                                    </HBox>
                                </VBox>
                                <Label fx:id="actionFeedbackLabel" maxWidth="1.7976931348623157E308"
                                       styleClass="feedback-label" text="" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </items>
</SplitPane>
