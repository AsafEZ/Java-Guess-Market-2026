<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="eventsSplitPane" dividerPositions="0.38" orientation="HORIZONTAL"
           styleClass="workspace-split-pane"
           xmlns="http://javafx.com/javafx/25.0.4"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="guessmarket.javafx.controller.EventsController">
    <fx:define>
        <ToggleGroup fx:id="mechanismFilterGroup"/>
        <ToggleGroup fx:id="statusFilterGroup"/>
        <ToggleGroup fx:id="commissionFilterGroup"/>
    </fx:define>
    <items>
        <VBox fx:id="eventBrowserPane" minWidth="250.0" prefWidth="350.0"
              spacing="12.0" styleClass="master-pane">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
            </padding>
            <Label styleClass="section-title" text="Events"/>
            <GridPane fx:id="eventFilterBar" hgap="8.0" vgap="8.0" styleClass="filter-panel">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="76.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <children>
                    <Label styleClass="filter-label" text="Method" GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>
                    <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <ToggleButton mnemonicParsing="false" selected="true" styleClass="filter-toggle"
                                      text="All" toggleGroup="$mechanismFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="LMSR" toggleGroup="$mechanismFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="Order Book" toggleGroup="$mechanismFilterGroup"/>
                    </HBox>
                    <Label styleClass="filter-label" text="Status" GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>
                    <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <ToggleButton mnemonicParsing="false" selected="true" styleClass="filter-toggle"
                                      text="All" toggleGroup="$statusFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="Not Started" toggleGroup="$statusFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="Active" toggleGroup="$statusFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="Closed" toggleGroup="$statusFilterGroup"/>
                    </HBox>
                    <Label styleClass="filter-label" text="Commission" GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>
                    <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <ToggleButton mnemonicParsing="false" selected="true" styleClass="filter-toggle"
                                      text="All" toggleGroup="$commissionFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="Purchase" toggleGroup="$commissionFilterGroup"/>
                        <ToggleButton mnemonicParsing="false" styleClass="filter-toggle"
                                      text="Close" toggleGroup="$commissionFilterGroup"/>
                    </HBox>
                </children>
            </GridPane>
            <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn minWidth="120.0" prefWidth="180.0" text="Event"/>
                    <TableColumn minWidth="86.0" prefWidth="100.0" text="Status"/>
                    <TableColumn minWidth="82.0" prefWidth="96.0" text="Method"/>
                    <TableColumn minWidth="96.0" prefWidth="110.0" text="Commission"/>
                    <TableColumn minWidth="80.0" prefWidth="96.0" text="Balance"/>
                </columns>
                <placeholder>
                    <Label text="No events loaded"/>
                </placeholder>
            </TableView>
        </VBox>
        <StackPane fx:id="eventDetailStateStack" minWidth="0.0" styleClass="detail-state-stack">
            <children>
                <VBox fx:id="eventEmptyState" alignment="CENTER" spacing="8.0"
                      styleClass="empty-state">
                    <Label styleClass="empty-state-title" text="No event selected"/>
                    <Label styleClass="muted-text" text="Select an event to view its details"/>
                </VBox>
                <ScrollPane fx:id="eventDetailsScrollPane" fitToWidth="true" hbarPolicy="AS_NEEDED"
                            pannable="true" vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox fx:id="eventDetailsPane" spacing="16.0" styleClass="detail-pane">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                            </padding>
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label fx:id="eventTitleLabel" styleClass="detail-title"
                                       text="Event details and trade"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="eventStatusLabel" styleClass="status-badge"
                                       text="Not Started"/>
                            </HBox>
                            <Label fx:id="eventDescriptionLabel" styleClass="body-text" text="-"
                                   wrapText="true"/>
                            <GridPane hgap="12.0" vgap="8.0" styleClass="metadata-grid">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="110.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints minWidth="110.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <children>
                                    <Label styleClass="metadata-label" text="Market Maker"
                                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <Label fx:id="eventMarketMakerLabel" text="-"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label styleClass="metadata-label" text="Event balance"
                                           GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    <Label fx:id="eventAccountBalanceLabel" text="-"
                                           GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                    <Label styleClass="metadata-label" text="Commission"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <Label fx:id="eventCommissionLabel" text="-"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label styleClass="metadata-label" text="Winning option"
                                           GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                    <Label fx:id="eventWinnerLabel" text="-"
                                           GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                </children>
                            </GridPane>
                            <VBox spacing="10.0" styleClass="content-section">
                                <Label styleClass="subsection-title" text="Options"/>
                                <TilePane fx:id="optionAreasTilePane" hgap="12.0" prefColumns="2"
                                          prefTileHeight="150.0" prefTileWidth="250.0"
                                          tileAlignment="TOP_LEFT" vgap="12.0">
                                    <children>
                                        <VBox minHeight="150.0" spacing="8.0" styleClass="option-area">
                                            <padding>
                                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                                            </padding>
                                            <Label styleClass="option-title" text="Option 1"/>
                                            <Label styleClass="muted-text" text="Mechanism-specific option area"
                                                   wrapText="true"/>
                                        </VBox>
                                        <VBox minHeight="150.0" spacing="8.0" styleClass="option-area">
                                            <padding>
                                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                                            </padding>
                                            <Label styleClass="option-title" text="Option 2"/>
                                            <Label styleClass="muted-text" text="Mechanism-specific option area"
                                                   wrapText="true"/>
                                        </VBox>
                                    </children>
                                </TilePane>
                            </VBox>
                            <TabPane fx:id="eventSecondaryTabs" minHeight="240.0"
                                     tabClosingPolicy="UNAVAILABLE">
                                <tabs>
                                    <Tab text="Participation">
                                        <content>
                                            <TableView fx:id="participantTable">
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                                </columnResizePolicy>
                                                <columns>
                                                    <TableColumn minWidth="130.0" text="User"/>
                                                    <TableColumn minWidth="100.0" text="Role"/>
                                                    <TableColumn minWidth="110.0" text="Option 1"/>
                                                    <TableColumn minWidth="110.0" text="Option 2"/>
                                                </columns>
                                                <placeholder>
                                                    <Label text="No participation information"/>
                                                </placeholder>
                                            </TableView>
                                        </content>
                                    </Tab>
                                    <Tab text="Trade history">
                                        <content>
                                            <TableView fx:id="eventTradeHistoryTable">
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                                </columnResizePolicy>
                                                <columns>
                                                    <TableColumn minWidth="64.0" text="#"/>
                                                    <TableColumn minWidth="120.0" text="Option"/>
                                                    <TableColumn minWidth="90.0" text="Quantity"/>
                                                    <TableColumn minWidth="100.0" text="Share cost"/>
                                                    <TableColumn minWidth="96.0" text="Commission"/>
                                                    <TableColumn minWidth="92.0" text="Total"/>
                                                </columns>
                                                <placeholder>
                                                    <Label text="No trades recorded"/>
                                                </placeholder>
                                            </TableView>
                                        </content>
                                    </Tab>
                                </tabs>
                            </TabPane>
                            <HBox fx:id="eventActionPlaceholder" alignment="CENTER_RIGHT" spacing="8.0">
                                <Button disable="true" mnemonicParsing="false" text="Open event"/>
                                <Button disable="true" mnemonicParsing="false" text="Close event"/>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </items>
</SplitPane>
