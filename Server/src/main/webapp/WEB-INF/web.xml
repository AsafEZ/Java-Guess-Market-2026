<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <listener>
        <listener-class>guessmarket.server.EngineContextListener</listener-class>
    </listener>
    <servlet>
        <servlet-name>health</servlet-name>
        <servlet-class>guessmarket.server.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>health</servlet-name>
        <url-pattern>/api/health</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>guessmarket.server.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/api/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>event-upload</servlet-name>
        <servlet-class>guessmarket.server.EventUploadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>event-upload</servlet-name>
        <url-pattern>/api/events/upload</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>events</servlet-name>
        <servlet-class>guessmarket.server.EventsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>events</servlet-name>
        <url-pattern>/api/events</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>users</servlet-name>
        <servlet-class>guessmarket.server.UsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>users</servlet-name>
        <url-pattern>/api/users</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>account-deposit</servlet-name>
        <servlet-class>guessmarket.server.AccountDepositServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>account-deposit</servlet-name>
        <url-pattern>/api/account/deposit</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>account-history</servlet-name>
        <servlet-class>guessmarket.server.AccountHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>account-history</servlet-name>
        <url-pattern>/api/account/history</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>event-details</servlet-name>
        <servlet-class>guessmarket.server.EventDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>event-details</servlet-name>
        <url-pattern>/api/event</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>account</servlet-name>
        <servlet-class>guessmarket.server.AccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>account</servlet-name>
        <url-pattern>/api/account</url-pattern>
    </servlet-mapping>
</web-app>
